# AWS Lakehouse Configuration (Amazon S3 & RDS)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-retail-lakehouse-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_S3_ENDPOINT_URL=http://localhost:4566  # Optional: for LocalStack

# PostgreSQL Configuration (Amazon RDS / Aurora or Local / Docker container)
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=retail_secret_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=retail_db
POSTGRES_SSLMODE=prefer
AIRFLOW_DB=airflow_db

# Apache Airflow Configuration (AWS MWAA or Local Container)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=

# Generative AI (Google Cloud Vertex AI / Gemini API - falls back to deterministic template if blank)
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_API_KEY=your_vertex_or_gemini_api_key_here
VERTEX_MODEL=gemini-1.5-flash
